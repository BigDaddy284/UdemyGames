# '*' Ignores everything

# '!your_folder/filename.type'Ignore specific files if needed

# '.txt/ Ignore by file type

# Ignore Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Pp]ackages/
[Pp]roject[Ss]ettings/ProjectVersion.txt

# Ignore Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Ignore User-specific files
*.swp
*.idea/
.vscode/

# '!your_folder/' Unignores the specific folder

# '!your_folder/**' Unignores all contents within the specific folder recursively

# '!your_folder/filename.type'Unignore specific files